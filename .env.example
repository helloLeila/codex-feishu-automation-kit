# Copy this file to .env.local for Docker Compose, then fill in your own values.
# Never commit .env.local or put AppSecret in frontend code.
PORT=3210

# Optional base-image override for regions where Docker Hub is slow or blocked.
# Default: node:20-bookworm-slim
# Example (DaoCloud public mirror):
# NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:20-bookworm-slim
# You may also use an accessible private ACR/registry image with the same tag.
NODE_BASE_IMAGE=node:20-bookworm-slim

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_DEFAULT_AUTHOR=
WECHAT_AUTO_SYNC=false

# Optional public access guard. Leave EDITOR_AUTH_ENABLED=false for local-only use.
# For public deployment, set a long unique password and session secret here.
EDITOR_AUTH_ENABLED=false
EDITOR_AUTH_USER=editor
EDITOR_AUTH_PASSWORD=
EDITOR_SESSION_SECRET=

# Docker persists settings, credentials, articles, and custom themes here.
OPEN_WECHAT_EDITOR_CONFIG_DIR=/data/config
